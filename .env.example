# =========================================================
# DATABASE (PostgreSQL with pgvector)
# =========================================================
DATABASE_URL=postgresql+psycopg://dailyblog_user:dailyblog_password@localhost:5432/dailyblog

# =========================================================
# REDIS (Task queue, caching, and rate limiting)
# =========================================================
REDIS_URL=redis://localhost:6379/0

# =========================================================
# AUTHENTICATION (JWT)
# =========================================================
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =========================================================
# LLM PROVIDER CONFIGURATION
# Supported providers: deterministic, openai, anthropic, ollama
# =========================================================
LLM_PROVIDER=deterministic
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o
LLM_BASE_URL=

# =========================================================
# INTEGRATION CREDENTIAL VAULT (Optional)
# Key used to encrypt external credentials (e.g., WordPress app passwords)
# Defaults to JWT_SECRET_KEY if not specified
# =========================================================
INTEGRATION_SECRET_KEY=
